<?xml version="1.0" encoding="utf-8"?>
<!--
    Runo standalone logo mark — R glyph + three motion lines, deep green on transparent.
    108 × 108 viewport. Motion lines occupy x=0–22 (left space); R staff starts at x=27.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Motion lines — three horizontal speed dashes, centered on the R bowl (y≈36) -->
    <path android:fillColor="#0F3D2E" android:pathData="M4,26 H20 V30 H4 Z" />
    <path android:fillColor="#0F3D2E" android:pathData="M0,34 H22 V38 H0 Z" />
    <path android:fillColor="#0F3D2E" android:pathData="M4,42 H20 V46 H4 Z" />

    <!-- R lettermark: outer staff + bowl with evenOdd counter hole -->
    <path
        android:fillColor="#0F3D2E"
        android:fillType="evenOdd"
        android:pathData="
            M27,22 H66 C83,22 83,50 66,50 H38 V86 H27 Z
            M42,29 H62 C72,29 72,43 62,43 H42 Z" />

    <!-- R diagonal leg -->
    <path android:fillColor="#0F3D2E" android:pathData="M60,50 L83,86 H70 L47,50 Z" />

</vector>
