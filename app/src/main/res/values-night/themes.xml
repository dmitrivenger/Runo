<?xml version="1.0" encoding="utf-8"?>
<!-- Force cream background even when the system is in dark mode.
     Runo handles its own dark/light theming entirely inside Compose. -->
<resources>
    <style name="Theme.Runo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/runo_cream</item>
    </style>

    <style name="Theme.Runo.Splash" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/runo_cream</item>
        <item name="windowSplashScreenBackground">@color/runo_cream</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_runo_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Runo</item>
    </style>
</resources>
